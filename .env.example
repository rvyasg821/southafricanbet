# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Blocks search engines on every deploy by default (test/staging). Set to "true" ONLY on the
# live production deploy once it's ready to be found by Google.
ALLOW_INDEXING=false

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# --- Email (contact form + newsletter alerts) ---
# Leave SMTP_HOST empty and emails are just printed in the terminal.
# Local testing with Mailpit:  SMTP_HOST=localhost  SMTP_PORT=1025  (no user/pass), inbox at http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@southafricanbet.co.za
# Where "new newsletter subscriber" alerts go (contact form recipients are set in Admin -> Forms)
NOTIFY_EMAIL=info@southafricanbet.co.za

# --- Captcha (free Cloudflare Turnstile: dash.cloudflare.com -> Turnstile) ---
# Not needed locally (Cloudflare's test keys are used). REQUIRED in production, otherwise forms reject everything.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
